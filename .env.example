# Existing services still need their own credentials/configuration; never copy real secrets here.
JWT_SECRET=replace-with-a-local-development-secret
SERVICE_AUTH_SECRET=replace-with-a-separate-service-secret
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Official Project OSRM release. Preparation/runtime must use the same image.
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1
OSRM_SOURCE_DIR=./data/osrm
OSRM_DATA_DIR=./data/osrm/hcm
OSRM_THREADS=2
OSMIUM_MEMORY=4g
OSRM_PREPARE_MEMORY=3g
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT_MS=10000
OSRM_ROUTING_PROFILE=driving
