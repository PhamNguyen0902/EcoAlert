VISION_INTERNAL_TOKEN=replace-with-the-same-internal-service-secret
VISION_ALLOWED_IMAGE_HOSTS=your-bucket.s3.ap-southeast-1.amazonaws.com
VISION_ALLOW_PRIVATE_HOSTS=false
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_PIXELS=25000000
VISION_MAX_INFERENCE_SIDE=1280
VISION_REQUEST_TIMEOUT_SECONDS=12
