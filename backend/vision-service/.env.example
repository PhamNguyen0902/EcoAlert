YOLO_MODELS_CONFIG=config/models.json
# Legacy single model: unset YOLO_MODELS_CONFIG, then set YOLO_MODEL_PATH.
# YOLO_MODEL_PATH=models/BEST_ECOALERT_YOLO11N.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=auto
YOLO_MAX_UPLOAD_MB=10
YOLO_MERGE_IOU=0.6
YOLO_INFERENCE_TIMEOUT_SECONDS=8
YOLO_MAX_IMAGE_PIXELS=25000000
