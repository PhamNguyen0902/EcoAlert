PORT=3004
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ecoalert-gis-db
RABBITMQ_URL=amqp://localhost
# Compose DNS name; for host-only development, explicitly expose OSRM on loopback
# in an override and set the matching private URL. There is no public fallback.
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT_MS=10000
OSRM_ROUTING_PROFILE=driving
# Compose overrides this with /osrm-data. Host dev resolves from GIS folder.
OSRM_DATA_ROOT=../../data/osrm/hcm
