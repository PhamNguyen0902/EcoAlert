OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used for environmental incident and image analysis
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini

# Model used for the read-only EcoAlert AI Assistant
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct

OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=EcoAlert

# Optional backward compatibility. Remove after all deployments migrate.
OPENROUTER_MODEL=

# Optional future provider fallback models. Automatic fallback is not enabled yet.
OPENROUTER_ANALYSIS_FALLBACK_MODEL=
OPENROUTER_CHAT_FALLBACK_MODEL=

# Phase 1 multimodal rollout. Detection and segmentation can be enabled independently.
VISION_AI_ENABLED=false
VISION_SEGMENTATION_ENABLED=false
VISION_SERVICE_URL=http://vision-service:3007
VISION_TIMEOUT_MS=45000
MEDIA_SERVICE_URL=http://media-service:3003
INTERNAL_GATEWAY_SHARED_SECRET=replace-with-a-long-random-shared-secret
