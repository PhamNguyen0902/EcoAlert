OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used for environmental incident and image analysis
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o-mini

OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=EcoAlert

# Optional backward compatibility. Remove after all deployments migrate.
OPENROUTER_MODEL=

# Optional future provider fallback models. Automatic fallback is not enabled yet.
OPENROUTER_ANALYSIS_FALLBACK_MODEL=
AI_IMAGE_VALIDATION_HIGH_THRESHOLD=0.80
AI_IMAGE_VALIDATION_LOW_THRESHOLD=0.50
AI_CATEGORY_SUGGESTION_THRESHOLD=0.80
AI_CATEGORY_UNCLASSIFIED_THRESHOLD=0.50
