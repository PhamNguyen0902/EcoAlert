PORT=3005
NODE_ENV=development
RABBITMQ_URL=amqp://localhost
MONGO_URI=mongodb://localhost:27017/ecoalert-ai-db
ALERT_MONGO_URI=mongodb://localhost:27017/ecoalert-alert-db
REDIS_URL=redis://localhost:6379

# Set AI_CHAT_PROVIDER to openai or openrouter only after providing its matching key.
AI_CHAT_PROVIDER=disabled
AI_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=

ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW_SECONDS=60
# Must match the API Gateway value in production.
INTERNAL_GATEWAY_SHARED_SECRET=
